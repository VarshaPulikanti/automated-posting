# Copy to .env and fill in the platforms you want to enable.
# A platform with missing credentials is reported as "failed" (never crashes the request).

# Mastodon: Preferences > Development > New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: Settings > App Passwords (do NOT use your main password)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# Telegram: create a bot with @BotFather, add it as admin of a PUBLIC channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# DEV Community: Settings > Extensions > Generate API key
DEVTO_API_KEY=

# Telegraph: optional. If empty, an anonymous account is created automatically.
TELEGRAPH_ACCESS_TOKEN=
